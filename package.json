{
  "name": "agentdeck",
  "version": "0.1.0",
  "description": "A local-first terminal dashboard for AI-agent readiness in secure and air-gapped environments.",
  "type": "module",
  "bin": {
    "agentdeck": "./dist/index.js",
    "ad": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "agents",
    "cli",
    "typescript",
    "airgap",
    "developer-tools",
    "terminal-dashboard",
    "security"
  ],
  "author": "Katherine Weston",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^4.1.9"
  }
}
