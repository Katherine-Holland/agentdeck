{
  "mode": "local-only",
  "allow": [
    "src/**",
    "test/**",
    "tests/**",
    "docs/**",
    "README.md"
  ],
  "review": [
    "package.json",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    ".github/**",
    "infra/**"
  ],
  "deny": [
    ".env",
    ".env.*",
    ".ssh/**",
    "credentials.json",
    "service-account.json",
    "*.pem",
    "*.key",
    ".npmrc"
  ],
  "notes": [
    "Generated locally by AgentDeck.",
    "Review before using as an enforcement policy.",
    "Deny rules should be applied before allow rules."
  ]
}